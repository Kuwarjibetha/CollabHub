require("dotenv").config();
const cluster = require("cluster");
const os = require("os");
const { createServer, initDatabase } = require("../app");
const { startWorkflows } = require("../workflow");
const { setupPrimary } = require("@socket.io/cluster-adapter");

const totalCPUs = os.cpus().length;
const numWorkers = Math.max(1, process.env.WORKERS ? Math.min(parseInt(process.env.WORKERS, 10), totalCPUs) : totalCPUs);
const PORT = process.env.PORT || 5000;



if (cluster.isPrimary) {

    console.log(` Primary Process PID: ${process.pid} is running`);
    console.log(` System has ${totalCPUs} CPU Core(s). Spawning ${numWorkers} Workers..`);
    async function initMaster() {
        try {

            await initDatabase();
            startWorkflows();


            // Socket.io Cluster Adapter: Master/Primary process acts as IPC bridge
            // setupPrimary() PEHLE — workers fork hone se pehle bridge ready hona chahiye
            setupPrimary();

            for (let i = 0; i < numWorkers; i++) {
                cluster.fork();
            }


            // Self-Healing / Auto-Recovery if any worker crashes
            cluster.on("exit", (worker, code, signal) => {
                console.warn(
                    ` [Worker Died] PID: ${worker.process.pid} exited (Code: ${code || signal}). Forking a new replacement worker...`
                );
                cluster.fork();
            });

        } catch (err) {
            console.error(" Fatal Error during Master initialization:", err);
            process.exit(1);
        }
    }

    initMaster();

} else {
    const { httpServer } = createServer();

    httpServer.listen(PORT, () => {
        console.log(` [Worker Process] PID: ${process.pid} listening on http://localhost:${PORT}`);
    });
}
